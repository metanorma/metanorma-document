PresentationProfile "base" {
  layer = "base"
  settings = { date_format = "own" footnote_sup = true contributor_name_order = "given_family" section_order = "preface,scope,normref,terms,definitions,middle,annex,bibliography,indexsect,colophon" bibdata_current = true address_precompose = true }
}

PresentationProfile "iso" {
  layer = "flavor"
  flavor = "iso"
  settings = { footnote_close = ")" footnote_delim_scope = "body" bibdata_labels = "document" i18n_class = "IsoDoc::Iso::I18n" section_order = "preface,scope,normref,main,annex,bibliography,indexsect,colophon" }
}

PresentationProfile "bsi" {
  layer = "flavor"
  flavor = "bsi"
  settings = { footnote_close = ")" }
}

PresentationProfile "bipm" {
  layer = "flavor"
  flavor = "bipm"
  settings = { footnote_open = "(" footnote_close = ")" }
}

PresentationProfile "example_dates" {
  layer = "taste"
  taste = "example_dates"
  settings = { date_format = "%-d %B %Y" contributor_name_order = "family_given" }
}

PresentationProfile "itu" {
  layer = "flavor"
  flavor = "itu"
  settings = { section_order = "boilerplate_clauses,preface,scope,normref,terms,definitions,middle,annex,bibliography,indexsect,colophon" }
}

PresentationProfile "document_language_dates" {
  layer = "taste"
  taste = "document_language_dates"
  settings = { date_format = "%-d %B %Y" date_language = "document" }
}
