<figure{% if block.id %} id="{{ block.id }}"{% endif %} class="{{ block.css_class }}" spellcheck="false" translation="no">
<pre><code{% if block.lang %} lang="{{ block.lang }}"{% endif %}>{{ block.code_html }}</code></pre>
{% if block.annotations_html %}<pre class="sourcecode"><div class="figdl"><p class="ListTitle">Key</p><dl>{{ block.annotations_html }}</dl></div></pre>{% endif %}
{% if block.name_html %}<figcaption>{{ block.name_html }}</figcaption>{% endif %}
</figure>
