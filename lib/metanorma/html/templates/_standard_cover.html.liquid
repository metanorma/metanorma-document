<div class="title-section">
<div class="cover-grid">
<div class="cover-meta">
{% if publisher_logos %}
  <div class="cover-publishers">
  {% for logo in publisher_logos %}
    {{ logo }}
  {% endfor %}
  </div>
{% endif %}
{% if doc_id %}
  <p class="cover-doc-id">{{ doc_id | escape }}</p>
{% endif %}
{% if pub_date %}
  <p class="cover-date">{{ pub_date | escape }}</p>
{% endif %}
{% comment %} Cover identity block, laid out like the isodoc titlepage.
  The flavor passes its bibdata model as `cover`; the model's lutaml-model
  auto-Drop (plus its `liquid` mappings) serves every fact. The title
  precedes the identity lines so the cover reads like the native
  "title • docnumber (draft …) edition Date: …" sequence. {% endcomment %}
{% if title %}
  <div class="cover-title"><span>{{ title | escape }}</span></div>
{% endif %}
{% if cover.tc_docnumber.size > 0 %}
  {% for num in cover.tc_docnumber %}
  <p class="cover-doc-id">{{ num | escape }}</p>
  {% endfor %}
{% else %}
  {% if cover.docnumber_undated %}
  <p class="cover-doc-id">{{ cover.docnumber_undated | escape }}{% if cover.draftinfo %} {{ cover.draftinfo | escape }}{% endif %}</p>
  {% elsif cover.draftinfo %}
  <p class="cover-doc-id">{{ cover.draftinfo | escape }}</p>
  {% endif %}
{% endif %}
{% if cover.edition_display %}
  <p class="cover-doc-id">{{ cover.edition_display | escape }}</p>
{% endif %}
{% if cover.revdate %}
  <p class="cover-doc-id">Date: {{ cover.revdate | escape }}</p>
{% endif %}
{% if cover.tc_docnumber.size > 0 %}
  {% if cover.docnumber_undated %}
  <p class="cover-doc-id">{{ cover.docnumber_undated | escape }}{% if cover.draftinfo %} {{ cover.draftinfo | escape }}{% endif %}</p>
  {% elsif cover.draftinfo %}
  <p class="cover-doc-id">{{ cover.draftinfo | escape }}</p>
  {% endif %}
{% endif %}
{% if cover.editorialgroup %}
  <p class="cover-doc-id">{{ cover.editorialgroup | escape }}</p>
{% endif %}
{% if cover.secretariat %}
  <p class="cover-doc-id">Secretariat: {{ cover.secretariat | escape }}</p>
{% endif %}
</div>
<div class="cover-body">
{% comment %} Native titlepage order: display title, French title,
  stage line, then ICS last. The doctype identity labels close the
  column so they never split the native "… Date: <revdate> TC <title>
  ICS:" cover band. {% endcomment %}
{% if title %}
  <div class="cover-title"><span>{{ title | escape }}</span></div>
{% endif %}
{% if title_fr %}
  <div class="cover-title-fr"><span>{{ title_fr | escape }}</span></div>
{% endif %}
{% if stage %}
  <div class="cover-stage"><p>{{ stage | escape }}</p></div>
{% endif %}
{% if cover.ics %}
  <p class="cover-ics"><strong>ICS:</strong> {{ cover.ics | escape }}</p>
{% endif %}
{% if doctype %}
  <p class="cover-doctype">{{ doctype | escape }}</p>
{% endif %}
{% if cover.ext.subdoctype %}
  <p class="cover-docsubtype">Document subtype: {{ cover.ext.subdoctype | capitalize | escape }}</p>
{% endif %}
</div>
</div>
</div>
<hr class="cover-separator" />
