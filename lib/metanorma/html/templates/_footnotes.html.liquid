<section class="footnotes-section" aria-label="Footnotes">
<h2 class="footnotes-title">Footnotes</h2>
<div class="footnotes">
{% for entry in footnotes %}
<div id="footnote-{{ entry.number }}" class="footnote">
{% for reference in entry.references %}<a href="#{{ reference | escape }}" class="footnote-backref" aria-label="Back to reference {{ forloop.index }}">&#x21A9;</a>{% endfor %}<span class="footnote-label">{{ entry.label }}</span>
{{ entry.content_html }}
</div>
{% endfor %}
</div>
</section>
