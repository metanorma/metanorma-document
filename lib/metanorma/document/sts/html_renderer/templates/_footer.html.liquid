<div class="footer-grid">
  <div class="footer-block">
    <p class="footer-license">
      {% if copyright %}{{ copyright | escape }} · {{ license | escape }}{% else %}{{ license | escape }}{% endif %}
    </p>
    <p class="footer-publisher">{{ publisher_name | escape }}</p>
    <p class="footer-address">{{ publisher_address | escape }}</p>
    <p class="footer-contact">
      {% if site_url != "" %}<a href="{{ site_url }}">{{ site_label | escape }}</a>{% endif %}{% if contact_mail != "" %} · <a href="mailto:{{ contact_mail | escape }}">{{ contact_mail | escape }}</a>{% endif %}
    </p>
  </div>
  <div class="footer-block footer-meta">
    <p><span class="footer-docid">{{ docid | escape }}</span></p>
    <p class="footer-meta-line">{% if show_series %}{% if series != "" %}Series {{ series | escape }} · {% endif %}{% endif %}{% if year != "" %}{{ year | escape }} · {% endif %}EN</p>
    <p class="footer-generated">
      <span class="mn-icon brand-logo-light">{{ mn_icon_light }}</span><span class="mn-icon brand-logo-dark">{{ mn_icon_dark }}</span>
      Generated by <a href="https://www.metanorma.org" title="Metanorma — aequitate verum">{{ generator_name | escape }}</a> {{ version | escape }}
    </p>
  </div>
</div>
